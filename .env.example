# Copy this file to `.env` on the Lightsail server and fill in real values.
#   cp .env.example .env
# Never commit a filled-in `.env`.

# Public URL of the live site — no trailing slash.
# Used for admin verification emails.
SITE_URL=https://YOUR_DOMAIN

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_PROJECT_ID=your-project-id

# Supabase → Project Settings → API → service_role  (secret — never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio → Get API key  (https://aistudio.google.com/apikey)
# Either key is enough: Assistant and Student both accept both names.
# Assistant mode
BALO_ASSISTANT_API_KEY=your-gemini-key
# Student / tutor mode (can be the same key)
GEMINI_API_KEY=your-gemini-key

# Optional backups
# BALO_ASSISTANT_API_KEY_BACKUP=
# GEMINI_API_KEY_BACKUP=

# How the Node server listens (nginx talks to this)
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
